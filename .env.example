# DeepTruth development configuration
ENVIRONMENT=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=sqlite:///./dev.db
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local

# REAL uses the Hugging Face detector below. DEMO is only for UI/testing.
INFERENCE_MODE=REAL
MODEL_ID=capcheck/ai-image-detection
MODEL_PATH=
MODEL_CACHE_DIR=./.model-cache
MODEL_REVISION=a6661e07d38f1a097bba07ca9415538819278f09
MODEL_DEVICE=auto
MODEL_LOW_CPU_MEM_USAGE=false

MAX_UPLOAD_SIZE_MB=20
VIDEO_SAMPLE_INTERVAL=2.0
MAX_ANALYZED_FRAMES=12
WORKER_POLL_INTERVAL_SECONDS=1.0

TRACKING_PROVIDER=
TRACKING_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

DEEPTRUTH_MODE=real

# Removal / OCR models
OCR_MODEL_NAME=PP-OCRv5_mobile_det
OCR_DEVICE=cpu
REMOVAL_MODEL=LaMa
REMOVAL_DEVICE=cpu
REMOVAL_MAX_DIMENSION=2048
