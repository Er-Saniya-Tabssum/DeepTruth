import React,{useEffect,useMemo,useState} from 'react'
import {Link} from 'react-router-dom'
import {api} from '../lib/api'

const verdictMeta=[['AI_GENERATED','AI-generated'],['AUTHENTIC','Likely authentic'],['POTENTIALLY_MANIPULATED','Potentially manipulated'],['INCONCLUSIVE','Inconclusive']]

export default function DashboardPage(){
 const [stats,setStats]=useState<any>(null); const [error,setError]=useState('')
 useEffect(()=>{api.analysis.stats().then(setStats).catch(e=>setError(e.message))},[])
 const total=stats?.total_analyses??0, completed=stats?.by_status?.COMPLETED??0, ai=stats?.by_verdict?.AI_GENERATED??0
 const maxVerdict=useMemo(()=>Math.max(1,...verdictMeta.map(([k])=>stats?.by_verdict?.[k]??0)),[stats])
 return <div className="max-w-7xl mx-auto px-5 py-8 pb-16">
  <div className="flex flex-col md:flex-row md:items-end justify-between gap-5"><div><div className="text-xs uppercase tracking-[.2em] text-cyan-300">Forensic workspace</div><h1 className="mt-2 text-4xl font-bold text-white">Your authenticity command center.</h1><p className="mt-2 text-slate-400">Analyze, investigate and preserve the evidence behind every result.</p></div><div className="flex gap-3"><Link to="/remove" className="px-4 py-3 rounded-xl bg-white/5 text-slate-200 font-semibold">Clean media</Link><Link to="/analyze" className="px-5 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold">+ New analysis</Link></div></div>
  {error&&<div className="mt-6 text-rose-300">{error}</div>}
  <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">{[['Analyses',total,'All time'],['Completed',completed,'Processed successfully'],['AI-generated',ai,'Model flagged'],['Storage',`${((stats?.storage_used_bytes??0)/1048576).toFixed(1)} MB`,'Uploaded media']].map(([label,val,sub])=><div className="card rounded-2xl p-5" key={label as string}><div className="text-sm text-slate-500">{label}</div><div className="mt-2 text-3xl font-bold text-white">{val}</div><div className="mt-1 text-xs text-slate-600">{sub}</div></div>)}</div>
  <div className="grid lg:grid-cols-[1.35fr_.65fr] gap-5 mt-5">
   <div className="card rounded-2xl p-6"><div className="flex justify-between"><div><h2 className="font-semibold text-white">Recent analyses</h2><p className="text-sm text-slate-500 mt-1">Latest activity from your account</p></div><Link to="/history" className="text-sm text-cyan-300">View all</Link></div><div className="mt-5 space-y-2">{(stats?.recent_analyses??[]).map((a:any)=><Link to={`/results/${a.analysis_id}`} key={a.analysis_id} className="flex items-center justify-between gap-4 p-4 rounded-xl bg-white/[.03] hover:bg-white/[.06]"><div className="min-w-0"><div className="truncate text-sm font-medium text-slate-200">{a.filename}</div><div className="text-xs text-slate-600 mt-1">{new Date(a.created_at).toLocaleString()}</div></div><div className="text-xs text-cyan-300">{a.verdict||a.status}</div></Link>)}{!stats?.recent_analyses?.length&&<div className="py-12 text-center text-slate-600">No analyses yet. Start your first forensic scan.</div>}</div></div>
   <div className="card rounded-2xl p-6"><h2 className="font-semibold text-white">Verdict distribution</h2><p className="text-sm text-slate-500 mt-1">Signals across completed analyses</p><div className="mt-6 space-y-5">{verdictMeta.map(([key,label])=>{const value=stats?.by_verdict?.[key]??0; return <div key={key}><div className="flex justify-between text-xs"><span className="text-slate-400">{label}</span><span className="text-slate-300">{value}</span></div><div className="mt-2 h-2 rounded-full bg-white/5 overflow-hidden"><div className="h-full bg-cyan-400 rounded-full" style={{width:`${Math.max(0,value/maxVerdict*100)}%`}}/></div></div>})}</div></div>
  </div>
  <div className="grid lg:grid-cols-3 gap-5 mt-5">
   <div className="card rounded-2xl p-6 lg:col-span-2"><h2 className="font-semibold text-white">How DeepTruth decides</h2><div className="grid md:grid-cols-3 gap-3 mt-5">{[['01','AI classifier','Pretrained ViT estimates the probability that an image is synthetic.'],['02','Context signals','Metadata, media properties and face detection add context without pretending they are proof.'],['03','Evidence report','Signals, model version and limitations are persisted for later review.']].map(([n,t,d])=><div className="rounded-xl border border-white/8 bg-white/[.025] p-4" key={n}><div className="text-cyan-300 text-xs font-bold">{n}</div><div className="mt-2 text-sm font-semibold text-white">{t}</div><p className="mt-2 text-xs leading-5 text-slate-500">{d}</p></div>)}</div></div>
   <div className="card rounded-2xl p-6"><h2 className="font-semibold text-white">Inference</h2><div className="mt-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 p-4"><div className="flex items-center gap-2 text-emerald-300 text-sm"><span className="w-2 h-2 rounded-full bg-emerald-400"/> Pretrained model</div><div className="mt-2 text-xs text-slate-400">CapCheck ViT • CIFAKE fine-tune</div></div><p className="mt-4 text-xs leading-5 text-slate-600">No local training is required. CPU inference works on ordinary development machines; CUDA can be enabled automatically when available.</p></div>
  </div>
 </div>
}
